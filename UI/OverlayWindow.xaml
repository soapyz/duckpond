<Window x:Class="DuckPond.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Background="#06110E" Cursor="Hand" ShowActivated="True" Opacity="0">
    <Grid x:Name="Root">
        <Image x:Name="Backdrop" Stretch="Fill" />
        <Rectangle Fill="#06110E" Opacity="0.22" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/duck.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock x:Name="TitleText" Text="休息一下" FontSize="24" Foreground="#BFE3D6"
                       HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI" />
            <TextBlock x:Name="CountText" Text="10:00" FontSize="104" FontWeight="Bold" Foreground="#F6C445"
                       HorizontalAlignment="Center" FontFamily="Segoe UI" Margin="0,2,0,2" />
            <TextBlock x:Name="SubText" Text="站起来走走，看看远处" Foreground="#9CBCB2" FontSize="15"
                       HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI" Margin="0,0,0,14" />
            <TextBlock Text="点击任意位置结束休息" Foreground="#6F8C84" FontSize="12"
                       HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI" />
        </StackPanel>
    </Grid>
</Window>
